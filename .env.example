# Configuration du Bot Discord (Architecture de développement)
# Les variables sont à copier depuis config.js pour un déploiement local
# Ne committez PAS le fichier .env - il est ignoré par .gitignore

# TOKEN DU BOT (Discord Application Token)
# Générez-le dans le portal développeur Discord après avoir créé une application
TOKEN=votre-token-discord-ici

# PREFIXE DE COMMANDE (pour les commandes slash et/ou traditionnelles)
# ";" = point-virgule (ex: ;help, ;test)
PREFIX=;

# ID DU SERVEUR (GuildId) - vide pour une application multi-serveur
GUILD_ID=your-server-id-here

# COULEUR DU BOT (hexadécimal sans # au début peut être utilisé)
COLOR=#0101DF

# ID DU MEMBRE STAFF (utilitaire/modération)
STAFF=your-staff-id-here

# ID DE LA LISTE DE WHITELISTA
WL=your-whitelist-id-here

# LIEN DE SOUTIEN (forum/discord)
SUPPORT=your-support-link-here

# TEXTE DU FOOTER (texte affiché à chaque message du bot)
FOOTER_TEXT=your-footer-text-here

# URL DE L'ICONE DU FOOTER (avatar/logo du bot)
FOOTER_ICON_URL=your-bot-icon-url-here
